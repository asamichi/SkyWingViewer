<UserControl x:Class="SkyWingViewer.Views.ImageViewerMain"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SkyWingViewer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Image Source="{Binding CurrentImagePath}" Stretch="Uniform" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Command="{Binding MovePrevCommand}" 
                        Background="Transparent" 
                        BorderBrush="Transparent"
                        >
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="1" 
                        Command="{Binding MoveNextCommand}" 
                        Background="Transparent" 
                        BorderBrush="Transparent"
                        >
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!--<Border Grid.Column="0" Background="Transparent">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding MovePrevCommand}" />
                    </Border.InputBindings>
                </Border>

                <Border Grid.Column="1" Background="Transparent">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding MoveNextCommand}" />
                    </Border.InputBindings>
                </Border>-->
            </Grid>
        </Grid>

        <DockPanel Grid.Row="1" Margin="10,15">
            <Slider Value="{Binding CurrentIndex}" 
                    Minimum="0" 
                    Maximum="{Binding MaxIndex}" 
                    TickFrequency="1" 
                    IsSnapToTickEnabled="True" 
                    TickPlacement="BottomRight" />
        </DockPanel>
    </Grid>
</UserControl>
